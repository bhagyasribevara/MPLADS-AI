# =====================================================================
# MPLADS-AI Platform Environment Configuration Template
# Duplicate this file as `.env` and supply your actual credentials.
# NEVER commit the actual `.env` file containing secrets to GitHub!
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (PostGIS + pgvector)
# ---------------------------------------------------------------------
# Supabase transaction pooler or direct connection URL
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase REST API & Keys (from Project Settings -> API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co/rest/v1/"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ---------------------------------------------------------------------
# 2. AI / ML API Keys
# ---------------------------------------------------------------------
# Google Gemini API Key (Gemini 2.5 Flash / Gemini 3.6 Flash)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Optional: Groq API Key (Llama 3.3 70B Fallback)
GROQ_API_KEY="your_groq_api_key_here"

# Hugging Face Access Token
HF_TOKEN="your_huggingface_access_token_here"

# ---------------------------------------------------------------------
# 3. Microservice Ports & Networking
# ---------------------------------------------------------------------
# Node.js Express Gateway Port
PORT=5000

# Python FastAPI ML Microservice URL
ML_SERVICE_URL="http://127.0.0.1:8001"

# JWT Secret & Expiry for RBAC Gateway
JWT_SECRET="replace_with_a_secure_random_string_in_production"
JWT_EXPIRES_IN="7d"
