# =====================================================================
# MPLADS-AI Platform .gitignore
# Prevents secrets, build artifacts, virtual environments & OS caches 
# from being committed to GitHub.
# =====================================================================

# --------------------------------------------------
# Secrets & Environment Variables (CRITICAL)
# --------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.pfx

# Keep template environment file in repo
!.env.example
!backend/.env.example
!ml-service/.env.example

# --------------------------------------------------
# Python & Virtual Environments
# --------------------------------------------------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/

# Jupyter / IPython
.ipynb_checkpoints

# --------------------------------------------------
# Node.js & Frontend Build Outputs
# --------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build artifacts
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# npm / yarn / pnpm cache & logs
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# OS & Editor Artifacts
# --------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo
*~

# --------------------------------------------------
# Application Uploads & Temporary Files
# --------------------------------------------------
uploads/
backend/uploads/
tmp/
temp/
*.tmp
scratch/
